from fastapi import FastAPI
import psycopg2
import os

app = FastAPI(title="Culinary AI API")

# Lấy thông tin kết nối từ môi trường K8s
DB_HOST = os.getenv("DB_HOST", "postgres-service") # Trỏ tới Service DB bạn vừa tạo
DB_USER = os.getenv("DB_USER", "admin")
DB_PASS = os.getenv("DB_PASS", "secretpassword")
DB_NAME = os.getenv("DB_NAME", "culinary_ai")

@app.get("/")
def read_root():
    return {"status": "Backend API is running!"}

@app.get("/health/db")
def check_db():
    try:
        conn = psycopg2.connect(
            host=DB_HOST,
            user=DB_USER,
            password=DB_PASS,
            dbname=DB_NAME
        )
        conn.close()
        return {"database": "Connected successfully to PostgreSQL in Kubernetes!"}
